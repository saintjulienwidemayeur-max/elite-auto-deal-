# Base de données PostgreSQL (Render Postgres ou Supabase)
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base

# Freda Pay Issuing : clé secrète (sk_test_... en Sandbox, sk_live_... en Live). Jamais dans le navigateur.
FREDA_SECRET_KEY=sk_test_xxx
# Secret whsec_... reçu à l'enregistrement de l'URL https://VOTRE-DOMAINE/webhooks/freda
FREDA_WEBHOOK_SECRET=whsec_xxx
# false tant que le paiement par carte n'est pas activé en Live
CARTE_ACTIVE=true

# Adresse publique du site (sert au retour après paiement par carte)
PUBLIC_URL=https://eliteautodeal.com
ADMIN_PASSWORD=choisir-un-mot-de-passe-long
SESSION_SECRET=chaine-aleatoire-de-64-caracteres

# Emails (bienvenue + codes OTP) via Brevo : clé API v3 et expéditeur VALIDÉ dans Brevo (Senders & IP). Sans clé, aucun email n'est envoyé.
BREVO_API_KEY=
EMAIL_EXPEDITEUR=contact@eliteautodeal.com
EMAIL_EXPEDITEUR_NOM=Elite Auto Deal
# Logo des emails : URL publique (https) d'une image PNG blanche sur fond transparent, ~560 px de large. Sans elle, le nom s'affiche en texte.
EMAIL_LOGO_URL=

# Fichiers clients : Supabase Storage (bucket privé "dossiers") recommandé, sinon disque local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=dossiers
UPLOAD_DIR=./uploads
WHATSAPP_NUMERO=50942405729
